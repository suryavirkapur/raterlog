DATABASE_URL=postgres://postgres:postgres@localhost:5432/raterlog
CLICKHOUSE_URL=http://raterlog:raterlog@localhost:8123
CLICKHOUSE_DB=raterlog
APP_URL=http://localhost:3000
COOKIE_SECURE=false
HTTP_ADDR=0.0.0.0:8080
# SMTP for invite emails (optional; invites can also be shared as links)
SMTP_HOST=
SMTP_PORT=1025
# AI copilot upgrade (optional)
# OPENAI_API_KEY=
# ClickHouse storage tiering (optional): name of a storage policy defined
# server-side (see deploy/clickhouse/storage.xml; try it locally with
# docker-compose.tiered.yml). Events older than CLICKHOUSE_HOT_DAYS move to
# the policy's 'cold' volume via TTL; everything is deleted after 3 years.
# CLICKHOUSE_STORAGE_POLICY=tiered
# CLICKHOUSE_HOT_DAYS=30
# Billing via Dodo Payments (optional; billing endpoints return 503 when unset)
# DODO_API_KEY=
# DODO_API_BASE=https://test.dodopayments.com
# DODO_WEBHOOK_SECRET=whsec_...
# DODO_PRODUCTS=starter_month=pdt_..,starter_year=pdt_..,growth_month=pdt_..,growth_year=pdt_..,scale_month=pdt_..,scale_year=pdt_..
